{
  "version": "2.0.0",
  "tasks": [
    {"label": "BiQuad: Check", "type": "process", "command": "python3", "args": ["scripts/check.py"], "group": "test", "problemMatcher": []},
    {"label": "BiQuad: Universal preview", "type": "process", "command": "python3", "args": ["build_app.py"], "group": {"kind": "build", "isDefault": true}, "problemMatcher": []},
    {"label": "BiQuad: Native UI tests", "type": "process", "command": "python3", "args": ["scripts/check.py", "--ui"], "problemMatcher": []},
    {"label": "BiQuad: Demo workspace", "type": "process", "command": "${workspaceFolder}/.build/debug/BiQuadMonitor", "args": ["--demo", "--workspace"], "problemMatcher": []}
  ]
}
